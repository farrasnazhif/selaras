{
  "name": "selaras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <25"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "seed:selaras": "node --env-file=.env.local --experimental-strip-types scripts/seed-selaras.mjs",
    "test:workspace-rls": "node --env-file=.env.local scripts/check-workspace-rls.mjs",
    "test:rls": "node --env-file=.env.local scripts/check-rls.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.2.2",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.80.0",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.16.1",
    "lucide-react": "1.57.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.76.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.21",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
