# Browser Supabase configuration. Ordinary application queries use RLS, not an admin key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, disposable confirmed users for pnpm run test:rls.
# RLS_TEST_USER_A_EMAIL=
# RLS_TEST_USER_A_PASSWORD=
# RLS_TEST_USER_B_EMAIL=
# RLS_TEST_USER_B_PASSWORD=

# Server-only task variations. Leave the daily limit empty to disable paid requests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_DAILY_REQUEST_LIMIT=

# Optional development-only seed. Never prefix these secrets with NEXT_PUBLIC_.
# The application itself does not use the service-role key.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
